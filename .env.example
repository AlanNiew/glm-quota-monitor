# GLM 用量监控配置
# 将本文件复制为 .env 并填入真实凭证（切勿提交 .env 到仓库）

# 接口认证（浏览器 F12 抓包获取，对应请求头）
GLM_AUTHORIZATION=eyJhbGciOiJIUzUxMiJ9.your_token_here
GLM_ORGANIZATION=org-xxxxxxxx
GLM_PROJECT=proj_xxxxxxxx

# 可选：接口地址（默认即可）
# GLM_API_URL=https://bigmodel.cn/api/monitor/usage/quota/limit

# 刷新间隔（秒）
REFRESH_INTERVAL=60

# 告警阈值（百分比，已用占比达到即通知）
WARN_1=80
WARN_2=90
WARN_3=95

# SQLite 数据库路径（留空 = 默认 %APPDATA%\glm-monitor\usage.db，推荐）
# 打包后台运行时建议留空，避免 exe 旁目录只读 / 多用户冲突
# DB_PATH=usage.db

# 显示组件开关（1=开启 0=关闭）
# 后台运行推荐：仪表盘关、托盘 + 悬浮球开
DASHBOARD=0    # 终端仪表盘（打包后台运行建议关闭）
TRAY=1         # 系统托盘
FLOAT_BALL=1   # Token 悬浮球
